# Rasiko environment settings. Copy to .env and fill in. NEVER commit .env.
#
# Only server-level settings live here. Payment, WhatsApp, Claude AI, SMS, email (SMTP) and S3 keys are NOT set
# here: the Owner switches each one on and pastes its keys in Dashboard -> Settings -> Integrations, where they are
# stored encrypted. Everything paid is off until you do that.

# --- Core -----------------------------------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
# 50+ random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Encrypts the keys you paste in the dashboard. Generate once and back it up safely; losing it means re-entering keys.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DJANGO_DEBUG=false
# Your domain(s), comma separated
ALLOWED_HOSTS=rasiko.in,www.rasiko.in
CSRF_TRUSTED_ORIGINS=https://rasiko.in,https://www.rasiko.in
# Full public address, no trailing slash (used in emails, invoices, sitemaps, webhook URLs)
SITE_URL=https://rasiko.in

# --- Hidden admin addresses (change both to something only you know) ------------------------------------------------
ADMIN_URL=manage-7f3k/
DJANGO_ADMIN_URL=django-admin-x9q2/

# --- First Owner account (created by `manage.py bootstrap`; delete OWNER_PASSWORD after the first run) -----------
OWNER_EMAIL=owner@rasiko.in
OWNER_PASSWORD=

# --- Database and Redis -------------------------------------------------------------------------------------------
POSTGRES_DB=rasiko
POSTGRES_USER=rasiko
# Long random password
POSTGRES_PASSWORD=
DATABASE_URL=postgres://rasiko:${POSTGRES_PASSWORD}@db:5432/rasiko
DB_CONN_MAX_AGE=60
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# --- Optional -----------------------------------------------------------------------------------------------------
# Sender used before SMTP is set up in the dashboard
DEFAULT_FROM_EMAIL=Rasiko <no-reply@rasiko.in>
# Staff are signed out after this many seconds without activity (default 30 minutes)
STAFF_IDLE_TIMEOUT_SECONDS=1800
LOG_LEVEL=INFO
# Keep true behind Nginx + Let's Encrypt
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
# Days of daily database backups to keep
BACKUP_KEEP_DAYS=14
# Domain Nginx and Let's Encrypt use (no www, no https://)
DOMAIN=rasiko.in
